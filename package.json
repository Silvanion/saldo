{
  "name": "saldo-app",
  "private": true,
  "version": "1.4.0",
  "description": "Aplikacja do zarządzania finansami osobistymi i domowymi.",
  "author": "Silvanion",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.saldo.app",
    "productName": "Saldo",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.finance",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Silvanion",
      "repo": "saldo"
    }
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist dist-electron server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "dev:desktop": "npm run build && electron .",
    "build:desktop": "npm run build && electron-builder",
    "build:desktop:all": "npm run build && electron-builder --mac --win",
    "release:desktop": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
