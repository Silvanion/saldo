# Environment Variables Example for Saldo App
#
# Zmienne VITE_* trafiają do paczki przeglądarkowej, więc może tu być wyłącznie
# publiczna konfiguracja klienta Firebase. Serwer Express (server.ts) w trybie
# produkcyjnym wymaga dodatkowo FIREBASE_PROJECT_ID oraz ALLOWED_ORIGINS
# (poza aplikacją desktopową) — to zmienne środowiskowe serwera, nie paczki.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
